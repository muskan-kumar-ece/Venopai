# ==========================================
# BACKEND ONLY VARIABLES
# ==========================================
# Database & Cache (Managed Neon PostgreSQL & Upstash Redis)
DATABASE_URL=postgresql://<db-user>:<db-password>@<db-host>:5432/<db-name>?sslmode=require
REDIS_URL=rediss://default:<redis-password>@<redis-host>:6379

# Authentication & Security
SECRET_KEY=<jwt-secret-key-at-least-32-chars>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Background Worker Configuration
CELERY_BEAT_INVENTORY_INTERVAL=60.0

# Payment - Razorpay TEST / Staging
RAZORPAY_KEY_ID=<razorpay-test-key-id>
RAZORPAY_KEY_SECRET=<razorpay-test-key-secret>
RAZORPAY_WEBHOOK_SECRET=<razorpay-webhook-secret>

# Shipping - Shiprocket Staging / Sandbox
SHIPROCKET_EMAIL=<shiprocket-staging-email>
SHIPROCKET_PASSWORD=<shiprocket-staging-password>

# Media & Private Files - Cloudinary
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

# Transactional Email - Resend
RESEND_API_KEY=<resend-api-key>

# Error Monitoring - Sentry Staging
SENTRY_DSN=<sentry-staging-dsn>

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend URLs for redirect/email links
CLIENT_FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001

# ==========================================
# CLIENT FRONTEND PUBLIC VARIABLES (NEXT_PUBLIC_*)
# ==========================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_client

# ==========================================
# ADMIN FRONTEND PUBLIC VARIABLES (NEXT_PUBLIC_*)
# ==========================================
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_admin
