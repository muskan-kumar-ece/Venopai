# ==========================================
# BACKEND ONLY VARIABLES
# ==========================================
# Database (Local PostgreSQL or Managed like Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/venopai

# Redis (Upstash Redis or other remote/local instance)
REDIS_URL=redis://localhost:6379/0

# JWT Secrets
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Payment - Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Shipping - Shiprocket
SHIPROCKET_EMAIL=your_shiprocket_email
SHIPROCKET_PASSWORD=your_shiprocket_password

# Files - Cloudinary
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Email - Resend
RESEND_API_KEY=your_resend_api_key

# Monitoring - Sentry
SENTRY_DSN_BACKEND=your_sentry_dsn_backend

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend URLs for redirect/email links
CLIENT_FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001

# ==========================================
# CLIENT FRONTEND PUBLIC VARIABLES (NEXT_PUBLIC_*)
# ==========================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_client

# ==========================================
# ADMIN FRONTEND PUBLIC VARIABLES (NEXT_PUBLIC_*)
# ==========================================
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_admin
